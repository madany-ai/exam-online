# -------------------------------------------------------------------
# متغيّرات البيئة — انسخ هذا الملف إلى .env ثم املأ القيم
# cp .env.example .env
# لا ترفع .env إلى Git أبداً.
#
# quickest path with Neon:
#   npm i -g neon@latest && neon login
#   neon init -y --org-id <ORG> --project-id <PROJECT> --branch production --services postgres
#   neon deploy && neon env pull        # يسحب DATABASE_URL و DATABASE_URL_UNPOOLED
# -------------------------------------------------------------------

# رابط قاعدة البيانات المُجمَّعة (Pooler / PgBouncer) — يُستخدم لحركة التطبيق.
# على Neon: يملكه الأمر `neon env pull` (أو انسخه من صفحة Connect في Neon Console).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# رابط مباشر (بدون -pooler) — للترحيلات و prisma migrate فقط.
# اتركه فارغاً إن كنت تستخدم قاعدة PostgreSQL محلية (بلا PgBouncer).
DATABASE_URL_UNPOOLED=""

# رابط التطبيق العام — يُستخدم في بناء روابط الاختبارات المشاركة.
# محلياً: http://localhost:3000   |   على Vercel: https://your-app.vercel.app
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------
# متغيّرات اختيارية
# ---------------------------------------------------------------

# قاعدة بيانات منفصلة للاختبارات المتكاملة (يجب أن يحتوي اسمها على "test")
# لا تُوضع في بيئة الإنتاج، وتُستخدم فقط عند تشغيل: npm test
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/exam_test?schema=public"

# بريد المعلم التجريبي الذي تنشئه بذرة التطوير (npm run db:seed) — للتطوير فقط
SEED_TEACHER_EMAIL="teacher@example.com"
SEED_TEACHER_PASSWORD="Teacher12345"
